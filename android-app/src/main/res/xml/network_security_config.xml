<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted only to loopback addresses, and only so a developer can point a debug build at a
  backend running on their own laptop.

  Everything else requires TLS. That matters more here than in most apps: the sync upload carries a
  supervisor's bearer token and a site's worker roster, and a mine-site Wi-Fi is exactly the kind of network
  where somebody is already sitting on the same subnet.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The host loopback as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

</network-security-config>
