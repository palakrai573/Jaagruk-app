<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jaagruk mark: an open eye.

  "Jaagruk" means alert, watchful. The mark says that literally, which is worth more than an
  abstract glyph in a launcher full of abstract glyphs. It replaced the Infinity lemniscate,
  which was two thin overlapping strokes plus four ring dots plus specular highlights - all of
  which vanish into mush at the 48 dp the icon is actually drawn at.

  Two shapes carry it: a lens outline in Sand 50 and an amber pupil. Both survive downscaling.

  Geometry: the adaptive-icon safe zone is the central 66 of the 108 viewport, so content must
  stay inside a radius of 33 from (54,54). This mark spans 22 horizontally and 23 vertically
  from centre, which clears the mask on every launcher shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The eye, as a lens: two quadratic curves meeting at the outer corners. Filled faintly so
      the pupil has something to sit on when the icon is very small, then stroked so the shape
      still reads when it is large.
    -->
    <path
        android:fillColor="#FBF9F6"
        android:fillAlpha="0.16"
        android:pathData="M32,54 Q54,31 76,54 Q54,77 32,54 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FBF9F6"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,54 Q54,31 76,54 Q54,77 32,54 Z" />

    <!-- Iris, Amber 600. The one warm note against the teal. -->
    <path
        android:fillColor="#C2691A"
        android:pathData="M54,54m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />

    <!-- Pupil, Teal 900, so the iris reads as a ring rather than a dot. -->
    <path
        android:fillColor="#00363A"
        android:pathData="M54,54m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />

    <!-- Catchlight. Small, but it is what makes the eye look open rather than drawn. -->
    <path
        android:fillColor="#FBF9F6"
        android:fillAlpha="0.85"
        android:pathData="M50.5,50.5m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />

    <!--
      Brow: a short arc above the eye, Amber 400. Reads as attention rather than decoration,
      and gives the mark an asymmetry that makes it recognisable in a grid of round icons.

      Coordinates are constrained by the safe zone, not chosen for looks. At x=38 the safe
      radius of 33 allows y no smaller than about 26, and this curve's apex sits at y=30 with
      its stroke edge at 28.3 - inside on every mask. An earlier version apexed at 22.5 and
      would have been shaved off by a circular mask on exactly the launchers that use one.
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E8942F"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M38,34 Q54,26 70,34" />

</vector>
