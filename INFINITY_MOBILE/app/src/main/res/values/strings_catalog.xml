    <!-- ================================ PPE and height ================================ -->
    <string name="step_ppe_task_match_prompt">You are angle-grinding steel. Choose everything you need.</string>
    <string name="step_ppe_task_match_remedy">Helmet, face shield, gloves and ear protection. A loose scarf near a grinder is how people lose fingers.</string>
    <string name="step_height_anchor_point_prompt">Point at the anchor you may clip your harness to.</string>
    <string name="step_height_anchor_point_remedy">A structural anchor rated for arrest. Never a pipe, a ladder or a scaffold handrail.</string>
    <string name="step_harness_inspection_sequence_prompt">Put the harness inspection steps in order.</string>
    <string name="step_harness_inspection_sequence_remedy">Label, webbing, stitching, hardware, lanyard. If the label is unreadable the harness is out of service.</string>
    <string name="step_ladder_angle_prompt">At what angle should a leaning ladder be set?</string>
    <string name="step_ladder_angle_remedy">One out for every four up. Steeper tips backwards; shallower slides out.</string>
    <string name="step_ppe_defective_item_prompt">Your harness webbing has a cut in it. What do you do?</string>
    <string name="step_ppe_defective_item_remedy">Replace it and take the damaged one out of service. A cut in the webbing is the whole harness gone.</string>

