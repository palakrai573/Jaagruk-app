# Copy to backend/.env and edit. Never commit the real file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, no server needed) — fine for development and the test suite:
JAAGRUK_DATABASE_URL=sqlite:///./jaagruk.db
# PostgreSQL (production). Requires: pip install -r requirements-postgres.txt
# JAAGRUK_DATABASE_URL=postgresql+psycopg://jaagruk:CHANGE_ME@localhost:5432/jaagruk

# ---------------------------------------------------------------------------
# Security — MUST be replaced before any real deployment
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JAAGRUK_JWT_SECRET=change-me-this-value-is-not-secret-and-the-app-will-refuse-to-start-in-prod
JAAGRUK_ACCESS_TOKEN_MINUTES=30
JAAGRUK_REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | test | production
# 'production' turns on strict startup checks: a default secret or a debug flag aborts boot.
JAAGRUK_ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser (the admin dashboard).
JAAGRUK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
JAAGRUK_MEDIA_ROOT=./media_store
JAAGRUK_MAX_MEDIA_BYTES=8388608

# ---------------------------------------------------------------------------
# Sync limits
# ---------------------------------------------------------------------------
JAAGRUK_MAX_BATCH_ITEMS=100
# A certificate issued more than this far ahead of server time is rejected outright;
# anything inside the window is accepted and flagged for review.
JAAGRUK_MAX_CLOCK_SKEW_SECONDS=86400

# ---------------------------------------------------------------------------
# Public verification URL printed on certificate cards
# ---------------------------------------------------------------------------
JAAGRUK_VERIFY_BASE_URL=https://jaagruk.jharkhand.gov.in
