<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: Teal 700 full bleed, with a darker vignette toward the edges.

  Full bleed matters. The launcher masks this layer to a circle, squircle, rounded square or
  teardrop depending on the device, and it also parallaxes the layer as the user swipes. Any
  gap at the edge shows as a torn corner on some launchers and not others.

  Teal rather than blue: the palette in docs/REVAMP_PLAN.md section 4.1 keeps blue out of the
  brand entirely so the ISO 7010 signal colours mean only what they mean on a real sign.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Teal 900, edge to edge, so the mask never finds a gap. -->
    <path
        android:fillColor="#00363A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Teal 700 centre, lifting the middle where the mark sits. -->
    <path
        android:fillColor="#00696E"
        android:pathData="M54,54m-54,0a54,54 0,1 1,108 0a54,54 0,1 1,-108 0" />

    <!-- Teal 500, a soft inner glow. -->
    <path
        android:fillColor="#1E9298"
        android:fillAlpha="0.35"
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0" />

</vector>
