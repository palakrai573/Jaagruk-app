<?xml version="1.0" encoding="utf-8"?>
<!--
  Scenario catalog strings, Hindi.

  Technical safety vocabulary follows what is actually said on a Jharkhand site rather than a dictionary:
  "हार्नेस" not "उपस्कर बंध", "लॉकआउट" not "अवरोधन", "परमिट" not "अनुज्ञप्ति". A worker who has to decode the
  word has already lost the seconds the drill is measuring.

  Distractors are translated as carefully as correct answers. A wrong option that reads awkwardly is a wrong
  option nobody picks, and a test whose wrong answers give themselves away measures nothing.
-->
<resources>

    <string name="module_fire_title">आग और विस्फोट पर कार्रवाई</string>
    <string name="module_fire_desc">अलार्म बजाना, सही अग्निशामक चुनना, और उस रास्ते से निकलना जो असल में खुला है।</string>
    <string name="module_gas_title">गैस और बंद जगह में प्रवेश</string>
    <string name="module_gas_desc">गैस क्षेत्र पहचानना, प्रवेश का क्रम, साथी जाँच, और गिरे हुए साथी के पीछे अंदर न जाने की वजह।</string>
    <string name="module_machinery_title">मशीन लॉकआउट और गार्ड</string>
    <string name="module_machinery_desc">जमा ऊर्जा अलग करना, अपना ताला लगाना, और जाम खोलते समय ख़ुद उसका हिस्सा न बनना।</string>
    <string name="module_ppe_height_title">सुरक्षा उपकरण और ऊँचाई पर काम</string>
    <string name="module_ppe_height_desc">काम के हिसाब से सुरक्षा चुनना, हार्नेस जाँचना, और ऐसा ऐंकर चुनना जो टिके।</string>
    <string name="module_electrical_title">बिजली में पहली कार्रवाई</string>
    <string name="module_electrical_desc">छूने से पहले सप्लाई बंद करना, ख़राब केबल, परमिट, और झटके या जलने पर पहली मदद।</string>

