    <string name="module_fire_title">தீ மற்றும் வெடிப்பு பாதுகாப்பு</string>
    <string name="module_fire_desc">எச்சரித்தல், சரியான தீயணைப்பானைத் தேர்ந்தெடுத்தல், திறந்த பாதுகாப்புப் பாதையில் வெளியேறுதல்.</string>
    <string name="module_gas_title">வாயு மற்றும் அடைபட்ட இட நுழைவு</string>
    <string name="module_gas_desc">வாயு அபாயம், நுழைவு வரிசை, துணைவர் கண்காணிப்பு மற்றும் பாதுகாப்பான மீட்பு.</string>
    <string name="module_machinery_title">இயந்திரப் பூட்டல் மற்றும் தடுப்புகள்</string>
    <string name="module_machinery_desc">ஆற்றலைத் தனிமைப்படுத்துதல், தனிப்பட்ட பூட்டுகள் மற்றும் அடைப்பைப் பாதுகாப்பாக அகற்றுதல்.</string>
    <string name="module_ppe_height_title">பாதுகாப்பு உபகரணங்களும் உயரப் பணியும்</string>
    <string name="module_ppe_height_desc">பணிக்கேற்ற பாதுகாப்பு, உடற்கவச ஆய்வு மற்றும் உறுதியான நங்கூரத் தேர்வு.</string>
    <string name="module_electrical_title">மின் விபத்து முதல்நடவடிக்கை</string>
    <string name="module_electrical_desc">தொடுமுன் மின்சாரத் தனிமைப்படுத்தல், சேதமடைந்த கம்பிகள், அனுமதிகள் மற்றும் முதலுதவி.</string>
    <string name="scenario_fire_evac_full_title">பணிப்பகுதியில் தீ: முழுப் பயிற்சி</string>
    <string name="scenario_fire_evac_refresher_title">தீ பாதுகாப்பு: விரைவுப் பயிற்சி</string>
    <string name="scenario_gas_confined_full_title">அடைபட்ட இட நுழைவு: முழுப் பயிற்சி</string>
